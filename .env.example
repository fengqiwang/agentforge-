# ============================================================
# AgentForge 环境变量模板
# 复制为 .env 并填入实际值
#   cp .env.example .env
# ============================================================

# ---- 必需：LLM API Keys ----
# DeepSeek API (https://platform.deepseek.com/api_keys)
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/
LLM_CHAT_MODEL=deepseek-v4-flash

# Zhipu BigModel API for embeddings (https://open.bigmodel.cn/)
EMBEDDING_API_KEY=your-zhipu-api-key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3

# ---- 可选：基础服务端口覆盖 ----
# MYSQL_PORT=3306
# REDIS_PORT=6379
# CHROMA_PORT=8000
# BACKEND_PORT=8080
# FRONTEND_PORT=5173
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# ---- 可选：数据库密码（第三方部署用，已有服务可忽略） ----
# MYSQL_ROOT_PASSWORD=root123
# MYSQL_DATABASE=synthesis
# MYSQL_USER=agentforge
# MYSQL_PASSWORD=agentforge123

# ---- 可选：Grafana 密码 ----
# GRAFANA_PASSWORD=admin
